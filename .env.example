# Copy this file to .env and fill in your values (or export these as real
# environment variables). See app/config.py for defaults.

# --- Required for real LLM behavior ---
OPENAI_API_KEY=sk-...

# If unset (or empty), the app automatically runs in mock mode: a
# deterministic rule-based stand-in for the LLM, useful for offline testing
# but NOT representative of real answer quality. Set this to 0 explicitly
# once OPENAI_API_KEY is set, to be sure you're not accidentally in mock mode.
# USE_MOCK_LLM=0

MODEL_CHEAP=gpt-4o-mini
MODEL_STRONG=gpt-4o

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_db_analyst
DB_READONLY_USER=app_readonly
DB_READONLY_PASSWORD=readonly_dev_password
DB_SCHEMA=analyst

# --- API (used by the Streamlit UI to reach the backend) ---
API_BASE_URL=http://localhost:8000
